{
  "name": "forma",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "rig dev",
    "chat": "rig chat",
    "run": "rig run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inspect": "rig inspect",
    "doctor": "rig doctor",
    "upgrade": "rig upgrade",
    "dev:desktop": "rig dev",
    "build:desktop": "cd desktop && wails3 build",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/scripts/release.ps1"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "echarts": "^6.1.0",
    "katex": "^0.16.47",
    "lucide-static": "^0.544.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.13.0",
    "rig": "file:vendor/rig-0.3.0.tgz",
    "simple-icons": "^16.35.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jszip": "^3.10.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "puppeteer@25.13.0": true,
    "esbuild@0.28.2": true,
    "tesseract.js@7.0.0": true
  }
}
